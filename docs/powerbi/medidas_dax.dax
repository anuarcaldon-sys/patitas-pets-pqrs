// =====================================================================
// PATITAS-PETS - Medidas y columnas DAX del tablero
// Cada bloque se crea por separado en Power BI:
//   Medidas:  clic derecho sobre la tabla PQRS > Nueva medida > pegar.
//   Columnas: clic derecho sobre la tabla PQRS > Nueva columna > pegar.
// Las medidas con % se formatean como Porcentaje con 1 decimal.
// "+ 0" al final de un conteo hace que la tarjeta muestre 0 en lugar de "(En blanco)".
// =====================================================================

// ---------- Estadística obligatoria: promedio de días de respuesta ----------
// Días entre la radicación y el paso a Solucionada registrado en Historial.txt.
Promedio días de respuesta = ROUND ( AVERAGE ( PQRS[dias_respuesta] ), 0 )

// Texto para la tarjeta principal: muestra "Sin datos aún" en vez de quedar en blanco.
Promedio días de respuesta (texto) =
VAR Dias = [Promedio días de respuesta]
RETURN IF ( ISBLANK ( Dias ), "Sin datos aún", FORMAT ( Dias, "0" ) & " días" )

PQRS con fecha de solución = COUNT ( PQRS[dias_respuesta] ) + 0

// ---------- Generales ----------
Total PQRS = COUNTROWS ( PQRS )

% del total = DIVIDE ( [Total PQRS], CALCULATE ( [Total PQRS], ALLSELECTED ( PQRS ) ) )

Plazo promedio otorgado (días) =
ROUND ( AVERAGEX ( PQRS, DATEDIFF ( PQRS[fecha_radicacion], PQRS[fecha_maxima_respuesta], DAY ) ), 0 )

// ---------- Estadística 4: efectividad y resolución ----------
Solucionadas = CALCULATE ( [Total PQRS], PQRS[estado_peticion] = "Solucionada" )

Tasa de resolución = DIVIDE ( [Solucionadas], [Total PQRS] )

PQRS activas = CALCULATE ( [Total PQRS], PQRS[estado_peticion] IN { "Registrada", "En proceso" } )

// ---------- Estadística 5: vencimiento y plazo ----------
Vencidas = CALCULATE ( [Total PQRS], PQRS[estado_plazo] = "Vencida" ) + 0

Próximas a vencer = CALCULATE ( [Total PQRS], PQRS[estado_plazo] = "Próxima a vencer" ) + 0

Al día = CALCULATE ( [Total PQRS], PQRS[estado_plazo] = "Al día" ) + 0

% vencidas sobre activas = DIVIDE ( [Vencidas], [PQRS activas] )

Antigüedad promedio activas (días) =
ROUND ( CALCULATE ( AVERAGE ( PQRS[antiguedad_dias] ), PQRS[estado_peticion] IN { "Registrada", "En proceso" } ), 0 )

Retraso promedio vencidas (días) =
ROUND ( CALCULATE ( AVERAGE ( PQRS[dias_para_vencer] ), PQRS[estado_plazo] = "Vencida" ) * -1, 0 )

// COLUMNA (no medida): rango de días de retraso de cada PQRS vencida
Rango de retraso =
VAR Retraso = -PQRS[dias_para_vencer]
RETURN
    SWITCH (
        TRUE (),
        PQRS[estado_plazo] <> "Vencida", BLANK (),
        Retraso <= 30, "1. 1 a 30 días",
        Retraso <= 90, "2. 31 a 90 días",
        Retraso <= 180, "3. 91 a 180 días",
        "4. Más de 180 días"
    )

// ---------- Estadística 6: perfil y carga operativa ----------
PQRS por registrador (promedio) = DIVIDE ( [Total PQRS], DISTINCTCOUNT ( PQRS[usuario_registro] ) )

Registradores activos = DISTINCTCOUNT ( PQRS[usuario_registro] )

% Comunidad UdeA = DIVIDE ( CALCULATE ( [Total PQRS], PQRS[perfil_solicitante] = "Comunidad UdeA" ), [Total PQRS] )
